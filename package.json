{
  "name": "network-interceptor",
  "version": "1.0.0",
  "description": "Chrome MV3 extension that blocks outgoing requests and logs what would have been sent",
  "scripts": {
    "build": "node build.mjs",
    "build:test": "node build.mjs --test",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && playwright test",
    "test:unit": "playwright test --project=unit",
    "test-app": "node test/manual.ts"
  },
  "author": "",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "private": true
}
